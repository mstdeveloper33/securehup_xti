#!/bin/sh
# Fast, offline checks for every push. The complete suite remains scripts/check.
set -eu

XTI_PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$XTI_PROJECT_DIR"

sh -n \
    setup \
    xti \
    scripts/check \
    scripts/check-fast \
    scripts/python \
    scripts/bootstrap-python \
    scripts/setup-brand \
    scripts/setup-harvester \
    scripts/setup-nmap \
    scripts/verify-brand

"$XTI_PROJECT_DIR/scripts/python" -m compileall -q src
exec "$XTI_PROJECT_DIR/scripts/python" -m unittest -v \
