#!/bin/sh
# Fast, offline checks for every push. The complete suite remains scripts/check.
set -eu

XTI_PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$XTI_PROJECT_DIR"

sh -n \
    setup \
    xti \
    scripts/check \
    scripts/check-fast \
    scripts/python \
    scripts/setup-brand \
    scripts/setup-harvester \
    scripts/verify-brand

"$XTI_PROJECT_DIR/scripts/python" -m compileall -q src
exec "$XTI_PROJECT_DIR/scripts/python" -m unittest -v \
    tests/test_architecture.py \
    tests/test_setup.py \
    tests/test_setup_harvester.py \
    tests/test_theharvester_archive.py \
    tests/test_archive_http.py \
    tests/test_theharvester_archive_worker.py \
    tests/test_mitre_attack.py \
    tests/test_maigret_username.py \
    tests/test_sherlock_username.py \
    tests/test_brand_username_watches.py \
    tests/test_surface_source_evaluation.py \
    tests/test_surface_discovery_status.py \
    tests/test_source_readiness.py \
    tests/test_source_readiness_adapter.py \
    tests/test_daily_workflow.py \
    tests/test_collection_service.py \
    tests/test_collection_cli.py \
    tests/test_collection_watches.py \
    tests/test_collection_watch_cli.py \
    tests/test_ci_configuration.py \
    tests/test_cli.py \
    tests/test_storage.py \
    tests/test_domain.py
